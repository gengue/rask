# --- Postgres (docker compose) ---
POSTGRES_PORT=5432
DATABASE_URL=postgres://rask:rask@localhost:5432/rask

# --- ClickUp OAuth app ---
# Create at https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3000/auth/clickup/callback

# --- Secrets ---
# Both are 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts ClickUp OAuth tokens at rest in Postgres.
TOKEN_ENCRYPTION_KEY=
# Signs the httpOnly session cookie.
SESSION_SECRET=

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Webhooks ---
# Public URL ClickUp posts events to. For local dev expose the API with
# `tailscale funnel 3000` or ngrok, then paste the resulting https URL.
CLICKUP_WEBHOOK_URL=
# ClickUp returns this when the webhook is created; used to verify the
# X-Signature header on incoming events. Never skip that check.
CLICKUP_WEBHOOK_SECRET=

# --- Dev only ---
# Personal API token (pk_...) from ClickUp Settings > Apps. Used by the
# scripts under apps/worker to measure a real sync before OAuth is wired up.
# Not used by the running app.
CLICKUP_PERSONAL_TOKEN=
