# --- Postgres (docker compose) ---
POSTGRES_PORT=5432
DATABASE_URL=postgres://rask:rask@localhost:5432/rask

# --- ClickUp OAuth app ---
# Create at https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3000/auth/clickup/callback

# --- Secrets ---
# Both are 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts ClickUp OAuth tokens at rest in Postgres.
TOKEN_ENCRYPTION_KEY=
# Signs the httpOnly session cookie.
SESSION_SECRET=

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Who may sign in ---
# The ClickUp Workspace this deployment serves. Find it in any ClickUp URL:
# app.clickup.com/<team_id>/...
#
# This is the access control, and the API refuses to start without it in
# production. Reads come from our Postgres mirror, not from ClickUp, so a
# session is enough to read every task in it — ClickUp's own per-Space
# permissions are never consulted on the read path. Unset, any ClickUp account
# anywhere could complete the OAuth flow and read the whole mirror.
CLICKUP_TEAM_ID=
# Optional second gate: a comma-separated list of emails. Blank means every
# member of the Workspace may sign in, which is usually what a team wants. Set
# it for a pilot, or where the Workspace has guests who should not be here.
RASK_ALLOWED_EMAILS=

# --- Worker ---
# How often each tracked list is re-polled when no webhook is delivering.
POLL_INTERVAL_MS=120000
# The same poll while a healthy webhook is delivering. Slower, never off:
# webhooks are lossy and have no replay, so this is what notices what they
# dropped. See "Webhooks" in the README for why ten minutes.
POLL_INTERVAL_WEBHOOK_MS=600000

# --- Webhooks ---
# Public URL ClickUp posts events to. Must be the full path, ending in
# /webhooks/clickup, and reachable from the internet over https.
#
# Leave it blank and nothing is registered: no webhook, no events, and the
# worker polls every tracked list every POLL_INTERVAL_MS as it always did.
# That is the normal state in dev. To try it locally, expose the API with
# `tailscale funnel 3000` or ngrok and paste the resulting https URL with
# /webhooks/clickup on the end.
CLICKUP_WEBHOOK_URL=
# Registers the webhook against one List instead of the whole Workspace.
# For a cautious first rollout, or a dev tunnel pointed at a real workspace.
# Leave blank in production.
CLICKUP_WEBHOOK_LIST_ID=
# Normally leave this blank.
#
# ClickUp returns a secret when a webhook is created, and the worker stores it
# encrypted in the `webhooks` table — the receiving endpoint reads it from
# there. Set this only to accept deliveries from a webhook created outside
# Rask, whose secret was never ours to store. It is checked alongside the
# stored ones, never instead of them. The X-Signature check is never skipped.
CLICKUP_WEBHOOK_SECRET=

# --- Dev only ---
# Personal API token (pk_...) from ClickUp Settings > Apps. Used by the
# scripts under apps/worker to measure a real sync before OAuth is wired up.
# Not used by the running app.
CLICKUP_PERSONAL_TOKEN=

# Only needed when running more than one checkout: cookies ignore the port,
# so two APIs on localhost otherwise overwrite each other's session.
SESSION_COOKIE_NAME=rask_session
