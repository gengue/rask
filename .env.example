# Rask environment.
#
# Copy to .env and fill in. Everything is grouped by when you need it: the
# first section is the minimum to boot anything, the second is what production
# additionally requires, and the rest have working defaults you can ignore
# until you have a reason not to.
#
# In production these are set on the host or in Coolify's UI rather than in a
# file. docker-compose.prod.yml passes every one of them through by name.


# =============================================================================
# Required everywhere
# =============================================================================

# Postgres. `bun run db:up` starts one locally with these credentials.
POSTGRES_PORT=5432
DATABASE_URL=postgres://rask:rask@localhost:5432/rask

# ClickUp OAuth app, from https://app.clickup.com/settings/apps.
# CLICKUP_REDIRECT_URI must match the redirect URL registered there character
# for character, or the callback fails with no useful error.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3000/auth/clickup/callback

# 32 random bytes each, base64: openssl rand -base64 32
#
# TOKEN_ENCRYPTION_KEY encrypts ClickUp tokens at rest. Rotating it orphans
# every stored token and every user has to sign in again.
TOKEN_ENCRYPTION_KEY=
# Signs the httpOnly session cookie.
SESSION_SECRET=


# =============================================================================
# Required in production
# =============================================================================

# The ClickUp Workspace this deployment serves. Find it in any ClickUp URL:
# app.clickup.com/<team_id>/...
#
# This is the access control, and the API refuses to start without it when
# NODE_ENV=production. Reads come from our Postgres mirror rather than from
# ClickUp, so a session is enough to read every task in it — ClickUp's own
# per-Space permissions are never consulted on the read path. Unset, any
# ClickUp account anywhere could complete the OAuth flow and read the mirror.
#
# Optional in development, where the Workspace is whatever your own token sees.
CLICKUP_TEAM_ID=

# Where the browser is served from, and where it lands after signing in.
# In production this is your public https origin; the API serves the SPA from
# the same one.
WEB_ORIGIN=http://localhost:5173

# Set to `production` on a deployment. It is what makes the session cookie
# Secure and what makes CLICKUP_TEAM_ID mandatory.
#
# The Docker image already sets it, so you only need this if you run the API
# outside the image.
# NODE_ENV=production


# =============================================================================
# Optional: who may sign in
# =============================================================================

# A comma-separated list of emails, on top of Workspace membership. Blank means
# every member of the Workspace may sign in, which is usually what a team
# wants. Set it for a pilot, or where the Workspace has guests who should not
# be here.
RASK_ALLOWED_EMAILS=


# =============================================================================
# Optional: API
# =============================================================================

API_PORT=3000

# Cookie name for the session. Only worth changing when you run more than one
# checkout: cookies are scoped by host and ignore the port, so two APIs on
# localhost otherwise overwrite each other's session.
SESSION_COOKIE_NAME=rask_session

# Directory of built SPA assets, which is how one process serves both. The
# Docker image sets it; setting it by hand is only for serving a build outside
# the image.
# WEB_DIST=./apps/web/dist

# Where the ClickUp API lives. The end-to-end suite overrides it with a closed
# port so its fixture stack never leaves the machine; there is no other reason
# to set it.
# CLICKUP_API_BASE=https://api.clickup.com/api


# =============================================================================
# Optional: worker tuning
# =============================================================================

# How often each tracked list is re-polled when no webhook is delivering.
POLL_INTERVAL_MS=120000
# The same poll while a healthy webhook is delivering. Slower, never off:
# webhooks are lossy and have no replay, so this is what notices what they
# dropped. See docs/webhooks.md for why ten minutes.
POLL_INTERVAL_WEBHOOK_MS=600000
# How often the outbox is drained. This is the delay between a user's edit and
# ClickUp seeing it, so it is deliberately short.
OUTBOX_INTERVAL_MS=2000
# Hour of the local day for the full reconciliation pass, 0-23.
RECONCILE_HOUR=3


# =============================================================================
# Optional: webhooks
# =============================================================================

# Public URL ClickUp posts events to. The full path, ending in
# /webhooks/clickup, reachable from the internet over https.
#
# Leave it blank and nothing is registered: no webhook, no events, and the
# worker polls every tracked list every POLL_INTERVAL_MS. That is the normal
# state in development, because ClickUp cannot reach localhost — and a URL that
# stops answering earns delivery failures against the real Workspace, 100 of
# which suspend the webhook. To try it locally, expose the API with
# `tailscale funnel 3000` or ngrok and paste the https URL with the path on it.
CLICKUP_WEBHOOK_URL=

# Registers the webhook against one List instead of the whole Workspace. For a
# cautious first rollout, or a dev tunnel pointed at a real workspace. Leave
# blank in production.
CLICKUP_WEBHOOK_LIST_ID=

# Normally blank.
#
# ClickUp returns a secret when a webhook is created, and the worker stores it
# encrypted in the `webhooks` table — the receiving endpoint reads it from
# there. Set this only to accept deliveries from a webhook created outside
# Rask, whose secret was never ours to store. It is checked alongside the
# stored ones, never instead of them. The X-Signature check is never skipped.
CLICKUP_WEBHOOK_SECRET=


# =============================================================================
# Development only
# =============================================================================

# Personal API token (pk_...) from ClickUp Settings > Apps.
#
# Used by `bun run --cwd apps/api link`, which points a local build at your real
# workspace without the OAuth round trip, and by the worker's measure script.
# Never read by the running app.
CLICKUP_PERSONAL_TOKEN=
